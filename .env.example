# ==========================================
# VARIABLES DE ENTORNO PARA BOGAD
# ==========================================

# 1. NÚMERO DE WHATSAPP RECEPTOR DE PEDIDOS DEL CARRITO
# Debe incluir el código de país sin el '+' ni guiones ni espacios.
# Ejemplos:
# Perú: 51987654321
# México: 521XXXXXXXXXX
# Colombia: 573XXXXXXXXX
VITE_BODEGA_WHATSAPP=51987654321

# 2. NOMBRE DE LA BODEGA
VITE_BODEGA_NAME="Bodega Don Carlos"

# 3. FORMATO VISIBLE DEL TELÉFONO
VITE_BODEGA_PHONE_DISPLAY="+51 987 654 321"

# 4. DIRECCIÓN FÍSICA
VITE_BODEGA_ADDRESS="Av. Los Laureles 342, Esquina Central"

# 5. CONFIGURACIÓN DE SUPABASE (Base de datos en la nube en tiempo real)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase
